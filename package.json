{
  "name": "local-shuffle-windows",
  "version": "0.2.0",
  "description": "Local video shuffle player for Windows with YouTube-compatible shortcuts",
  "license": "MIT",
  "author": "kouminiku-9900",
  "repository": {
    "type": "git",
    "url": "https://github.com/kouminiku-9900/local-shuffle-windows.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "mediainfo.js": "^0.3.7"
  },
  "build": {
    "appId": "com.udzur.local-shuffle-windows",
    "productName": "LocalShuffle",
    "asarUnpack": [
      "node_modules/mediainfo.js/dist/MediaInfoModule.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "LocalShuffle-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
